#!/usr/bin/env bash
# Configure Nginx to run as the 'nginx' user and listen on port 8080

# 1. Stop any running nginx process safely
pkill nginx || true

# 2. Update user directive in nginx.conf
sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf

# 3. Update port to 8080 in default configuration files
if [ -f /etc/nginx/sites-enabled/default ]; then
    sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/sites-enabled/default
    sed -i 's/listen \[::\]:80;/listen [::]:8080;/g' /etc/nginx/sites-enabled/default
fi

if [ -f /etc/nginx/conf.d/default.conf ]; then
    sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/conf.d/default.conf
    sed -i 's/listen \[::\]:80;/listen [::]:8080;/g' /etc/nginx/conf.d/default.conf
fi

# 4. Fix permissions for log and run directories
chown -R nginx:nginx /var/log/nginx
chown -R nginx:nginx /var/lib/nginx
mkdir -p /var/run/nginx
chown -R nginx:nginx /var/run/nginx

# 5. Start nginx directly
nginx

#!/usr/bin/env bash
# Configure Nginx to run as the 'nginx' user and listen on port 8080

# 1. Stop Nginx to release ports and processes
service nginx stop

# 2. Update user directive in nginx.conf (handles potential spaces)
sed -i 's/user\s\+www-data;/user nginx;/g' /etc/nginx/nginx.conf

# 3. Update port to 8080 in default configuration files if they exist
if [ -f /etc/nginx/sites-enabled/default ]; then
    sed -i 's/listen\s\+80;/listen 8080;/g' /etc/nginx/sites-enabled/default
    sed -i 's/listen\s\+\[::\]:80;/listen [::]:8080;/g' /etc/nginx/sites-enabled/default
fi

if [ -f /etc/nginx/conf.d/default.conf ]; then
    sed -i 's/listen\s\+80;/listen 8080;/g' /etc/nginx/conf.d/default.conf
    sed -i 's/listen\s\+\[::\]:80;/listen [::]:8080;/g' /etc/nginx/conf.d/default.conf
fi

# 4. Fix permissions for log and lib folders so 'nginx' user can write/read
chown -R nginx:nginx /var/log/nginx
chown -R nginx:nginx /var/lib/nginx

# 5. Start Nginx back up
service nginx start

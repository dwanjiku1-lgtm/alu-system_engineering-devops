#!/usr/bin/env bash
# Configure Nginx to run as the 'nginx' user and listen on port 8080

# 1. Stop nginx completely to clear active processes
service nginx stop

# 2. Update user directive in nginx.conf
sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf

# 3. Update port to 8080 in the default site configuration (both IPv4 and IPv6)
sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/sites-enabled/default
sed -i 's/listen \[::\]:80;/listen [::]:8080;/g' /etc/nginx/sites-enabled/default

# 4. Ensure the nginx user owns the log files/directories
chown -R nginx:nginx /var/log/nginx
chown -R nginx:nginx /var/lib/nginx

# 5. Start nginx back up
service nginx start
